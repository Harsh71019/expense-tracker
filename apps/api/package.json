{
  "name": "@treasury-ops/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "gen:openapi": "tsx scripts/generate-openapi.ts",
    "seed": "tsx --env-file=../../.env --env-file-if-exists=../../.env.development.local scripts/seed.ts",
    "dev": "tsc -p tsconfig.json && concurrently -k -n tsc,node -c blue,green \"tsc --watch -p tsconfig.json --preserveWatchOutput\" \"node --env-file=../../.env --env-file-if-exists=../../.env.development.local --watch --watch-path=dist --watch-path=../../packages/shared/dist dist/main.js\"",
    "lint": "eslint --config ../../eslint.config.mjs --no-warn-ignored --max-warnings=0 src/ test/ scripts/seed.ts scripts/seed/",
    "check:circular": "madge --circular --extensions ts src",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "migrate": "drizzle-kit migrate",
    "migrate:generate": "drizzle-kit generate",
    "migrate:status": "drizzle-kit check"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "8.5.0",
    "@better-auth/api-key": "1.6.24",
    "@bull-board/api": "8.1.2",
    "@bull-board/express": "8.1.2",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/throttler": "6.5.0",
    "@treasury-ops/shared": "workspace:*",
    "better-auth": "1.6.23",
    "bullmq": "5.80.9",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "pino-seq": "4.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@swc/core": "1.15.43",
    "@testcontainers/postgresql": "12.0.4",
    "@treasury-ops/config": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "10.0.3",
    "pino-pretty": "13.1.3",
    "testcontainers": "12.0.4",
    "unplugin-swc": "1.5.9"
  }
}
