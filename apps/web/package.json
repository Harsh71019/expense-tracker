{
  "name": "@treasury-ops/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "dev:mock": "NEXT_PUBLIC_MOCK_API=1 next dev",
    "check:circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src",
    "lint": "eslint --config eslint.config.mjs --no-warn-ignored --max-warnings=0 src/ e2e/ tests/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@sentry/nextjs": "10.66.0",
    "@tanstack/react-query": "5.101.2",
    "@treasury-ops/shared": "workspace:*",
    "better-auth": "1.6.23",
    "lucide-react": "1.25.0",
    "next": "16.2.10",
    "openapi-fetch": "0.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "5.2.0",
    "@treasury-ops/config": "workspace:*",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "openapi-msw": "2.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.0-beta"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
