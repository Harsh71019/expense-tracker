# /opt/apps/treasury_ops/.env  (server only — chmod 600, never committed)

NODE_ENV=production
GIT_SHA=development
LOG_LEVEL=info
# Set to true in .env.development.local for colorized single-line dev logs
# (pino-pretty) instead of raw JSON. Leave false/unset on servers — the JSON
# form is what the log pipeline expects.
LOG_PRETTY=false
SERVICE_ROLE=api

# --- Ports (internal; only nginx :3006 is exposed on the host) ---
API_PORT=4000
WEB_PORT=3000

# --- PostgreSQL ---
# Shared Postgres infrastructure (container 102). TreasuryOps gets its own database
# (treasury_ops) and a separately scoped database user -- never share a user/db with
# another app on that instance.
DATABASE_URL=postgres://treasury_ops:<replace-me>@<container-102-host>:5432/treasury_ops
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_IN_TXN_TIMEOUT_MS=30000
READINESS_TIMEOUT_MS=2000
GRACEFUL_SHUTDOWN_TIMEOUT_MS=15000

# --- Redis ---
# Shared Redis infrastructure (container 102). Use a distinct database number and a
# URL-encoded password.
REDIS_URL=redis://:replace-with-encoded-password@<container-102-host>:6379/2

# --- Local dev only ---
# Uncomment COMPOSE_PROFILES to bring up docker-compose.yml's throwaway local
# Postgres container instead of pointing at container 102 (e.g. offline, or to
# avoid touching shared infra while developing). When enabled, point DATABASE_URL
# above at postgres://treasury_ops:<POSTGRES_PASSWORD>@postgres:5432/treasury_ops
# instead. Leave both unset/commented in production.
# COMPOSE_PROFILES=local
# POSTGRES_PASSWORD=<replace-me>
# POSTGRES_BIND_ADDR=

# --- Better Auth ---
BETTER_AUTH_SECRET=<openssl rand -base64 32>
BETTER_AUTH_URL=http://192.168.0.226:3006
# HTTP on LAN -> secure cookies must be off or the browser drops them
# (same reason as COOKIE_SECURE=false in Taskflow). Flip to true behind NPMplus/TLS.
AUTH_COOKIE_SECURE=false
TRUSTED_ORIGINS=http://192.168.0.226:3006

# --- App ---
APP_TIMEZONE=Asia/Kolkata
DISABLE_SIGNUP=false        # set true after creating your account
DISABLE_RATE_LIMITING=false # dev/testing only -- never set true in production

# --- Notifications ---
# NTFY_URL/NTFY_TOPIC power ops pushes (cron run outcomes, process restarts --
# see docs/DEPLOYMENT-TREASURY-OPS.md "Ops notifications (ntfy)"). Leave both
# unset to disable those pushes entirely. They are NOT yet wired to the
# domain-notification outbox (budget alerts, bill reminders, etc.) -- that
# still uses LoggingNotificationAdapter until a real NotificationAdapter
# implementation exists (see notifications/notification-adapter.ts).
NTFY_URL=
NTFY_TOPIC=treasury_ops
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Observability (optional) ---
GLITCHTIP_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Seq (structured log search, see docs/DEPLOYMENT-TREASURY-OPS.md "Observability (Seq)").
# Leave both unset to disable Seq shipping -- stdout/docker logs are unaffected either way.
SEQ_URL=
SEQ_API_KEY=
