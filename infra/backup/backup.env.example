# Installed as /etc/treasury-backup/backup.env with mode 0600.
# Values are parsed by Bash. Quote values that contain spaces.

# PostgreSQL 18 connection. Local peer auth is preferred. If password auth is
# required, create PGPASSFILE with mode 0600; never put the password here or in
# DATABASE_URL because process arguments and logs are easier to leak.
PGHOST=/var/run/postgresql
PGPORT=5432
PGUSER=postgres
PGCONTROL_DATABASE=postgres
PGPASSFILE=

# Space-separated, deliberately allow-listed database names. Add the other
# production databases hosted by shared infrastructure LXC 102.
BACKUP_DATABASES="treasury_ops"
BACKUP_HOST=shared-infra-102

# Temporary plaintext exists here only while a job is running. Keep this on
# encrypted local storage with enough free space for an uncompressed dump.
STAGING_DIR=/var/lib/treasury-backup/staging
RESTORE_TEST_STAGING_DIR=/var/lib/treasury-backup/restore-test
RESTIC_CACHE_DIR=/var/cache/treasury-backup/restic
BACKUP_LOCK_FILE=/run/lock/treasury-backup.lock

# Colon-separated absolute paths on LXC 102. Every configured path is required:
# the backup fails instead of silently omitting a missing configuration.
# Do not add the app LXC's .env here unless it is actually mounted on LXC 102.
BACKUP_CONFIG_PATHS="/etc/postgresql:/etc/redis"

# Local repository must live on a physically separate Proxmox backup disk, not
# LXC 102's root disk. Create both repositories manually with `restic init`.
RESTIC_LOCAL_REPOSITORY=/mnt/proxmox-backup/restic/shared-postgres
RESTIC_LOCAL_PASSWORD_FILE=/etc/treasury-backup/local-repository-password

# Preferred: a direct S3-compatible repository such as Backblaze B2.
# Zero-cost start: rclone:treasury-drive:treasury-ops/restic
BACKUP_REQUIRE_OFFSITE=true
RESTIC_OFFSITE_REPOSITORY=rclone:treasury-drive:treasury-ops/restic
RESTIC_OFFSITE_PASSWORD_FILE=/etc/treasury-backup/offsite-repository-password
RCLONE_CONFIG=/etc/treasury-backup/rclone.conf

# For an S3-compatible off-site repository, set bucket-scoped credentials here
# instead of RCLONE_CONFIG. This file is root-only and is never included in its
# own backup snapshot.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Keep the latest 28 six-hour snapshots, plus calendar recovery points.
RETENTION_KEEP_LAST=28
RETENTION_KEEP_DAILY=30
RETENTION_KEEP_WEEKLY=12
RETENTION_KEEP_MONTHLY=12

# Weekly maintenance cycles through four deterministic data subsets in addition
# to the normal structural check.
CHECK_READ_DATA_PARTS=4

# Monthly restore test. Point this at the off-site repository so the test proves
# that the disaster-recovery copy—not merely the local copy—is usable.
RESTORE_TEST_REPOSITORY=rclone:treasury-drive:treasury-ops/restic
RESTORE_TEST_PASSWORD_FILE=/etc/treasury-backup/offsite-repository-password
RESTORE_TEST_DATABASE=treasury_ops
POSTGRES_VERIFY_IMAGE=postgres:18-alpine
RESTORE_TEST_TMPFS_SIZE=2g
VERIFY_SQL_FILE=/opt/treasury-backup/sql/verify-ledger.sql

# Optional Healthchecks-compatible ping URLs. Use a different check for each job.
# These are secrets; keep this file root-only and do not paste URLs into tickets.
BACKUP_HEALTHCHECKS_URL=
MAINTENANCE_HEALTHCHECKS_URL=
RESTORE_TEST_HEALTHCHECKS_URL=
